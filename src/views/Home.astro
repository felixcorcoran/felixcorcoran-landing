---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Scene from '../components/Scene.astro';
import Insight from '../components/Insight.astro';
import Case from '../components/Case.astro';
import Audit from '../components/Audit.astro';
import Work from '../components/Work.astro';
import Action from '../components/Action.astro';
import Footer from '../components/Footer.astro';
import { homeJsonLd } from '../data/seo';
import { langOf } from '../i18n';

// La landing, en los dos idiomas: / y /en/ (src/pages) la montan igual; el
// idioma lo da la ruta
const lang = langOf(Astro.currentLocale);
const meta = {
	es: {
		title: 'Webs, automatización e IA en Málaga · Félix Corcoran',
		description:
			'Miro cómo funciona tu negocio y construyo solo lo que merece la pena: webs, reservas, automatizaciones e IA. Desde Málaga. Auditoría gratuita.',
	},
	en: {
		title: 'Websites, automation and AI in Málaga · Félix Corcoran',
		description:
			"I look at how your business works and build only what's worth building: websites, bookings, automation and AI. Based in Málaga, Spain. Free audit.",
	},
}[lang];
---

<Layout title={meta.title} description={meta.description} jsonLd={homeJsonLd(lang)}>
	<Navbar />
	<main>
		<!-- 00 Hero · 01 Preguntas · 02 Insight: la única escena fija de la historia -->
		<Scene>
			<Hero />
			<Problem />
			<Insight />
		</Scene>
		<!-- 03 El caso · 04 La auditoría · 05 Más trabajo: flujo normal -->
		<Case />
		<Audit />
		<Work />
		<!-- 06 CTA → 07 Firma: la escena final -->
		<Action />
	</main>
	<Footer />
</Layout>

<script>
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { initReveal } from '../scripts/reveal';

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Entradas de las secciones en flujo normal. Con movimiento reducido (o
	// sin JS), todo está ya en su sitio.
	if (!reduceMotion) initReveal();

	// Al llegar con un ancla desde otra página (/#trabajo desde /contacto,
	// /en#work desde /en/contact), el navegador salta antes de que la escena
	// de la intro gane su altura, y el salto se queda corto: en el Insight. Se
	// repite una vez, ya montada (tras el primer refresh de ScrollTrigger, que
	// es cuando las alturas son las definitivas).
	const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
	if (target) {
		const settle = () => {
			ScrollTrigger.removeEventListener('refresh', settle);
			target.scrollIntoView({ behavior: 'instant' });
		};
		ScrollTrigger.addEventListener('refresh', settle);
	}
</script>
