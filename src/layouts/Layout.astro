---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { alternatesOf, langOf } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Páginas que no deben aparecer en buscadores (legales, 404). */
	noindex?: boolean;
	/** Datos estructurados (schema.org) de la página. */
	jsonLd?: Record<string, unknown>;
}

const { title, description, noindex = false, jsonLd } = Astro.props;

const lang = langOf(Astro.currentLocale);

// URL canónica (sin barra final, salvo la raíz) e imagen para compartir, en
// el idioma de la página
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const image = new URL(lang === 'en' ? '/og-en.png' : '/og.png', Astro.site);
const imageAlt = {
	es: 'felixcorcoran — Encuentro dónde se le escapan clientes y tiempo a tu negocio.',
	en: 'felixcorcoran — I find where your business loses customers and time.',
}[lang];

// La misma página en el otro idioma (para buscadores): solo si existe
const alternates = alternatesOf(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#FAF9F6" data-theme-color />
		<!-- Modo oscuro solo si el visitante lo eligió: aquí (botón de la
		     barra) o en el diagnóstico, que lo manda al enlazar (?tema=oscuro o
		     claro; se recuerda y se quita de la barra). Va antes de pintar para
		     que no haya destello claro. Sin almacenamiento, vale el del enlace. -->
		<script is:inline>
			try {
				const url = new URL(location.href);
				const asked = url.searchParams.get('tema');
				if (asked === 'oscuro') localStorage.setItem('tema', 'oscuro');
				if (asked === 'claro') localStorage.removeItem('tema');
				if (asked) {
					url.searchParams.delete('tema');
					history.replaceState(null, '', url.pathname + url.search + url.hash);
				}
				if (asked === 'oscuro' || (!asked && localStorage.getItem('tema') === 'oscuro')) {
					document.documentElement.dataset.theme = 'dark';
					document.querySelector('[data-theme-color]')?.setAttribute('content', '#131211');
				}
			} catch {
				if (location.search.includes('tema=oscuro')) document.documentElement.dataset.theme = 'dark';
			}
		</script>
		<!-- El monograma «fc» coral, el mismo que el logo del Perfil de Empresa -->
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap.xml" />
		{
			alternates && !noindex && (
				<>
					<link rel="alternate" hreflang="es" href={new URL(alternates.es, Astro.site)} />
					<link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
					<link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site)} />
				</>
			)
		}

		<!-- Al compartir el enlace (WhatsApp, LinkedIn, email…) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
		<meta property="og:site_name" content="Félix Corcoran" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />

		<Font cssVariable="--font-sora" preload={[{ weight: 400 }]} />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<slot />
	</body>
</html>
