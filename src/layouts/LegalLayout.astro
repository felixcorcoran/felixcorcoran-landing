---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { legal, missingLegal } from '../data/legal';

interface Props {
	title: string;
	description: string;
	/** Rótulo pequeño sobre el título (p. ej. «Legal»). */
	eyebrow?: string;
	heading: string;
}

const { title, description, eyebrow = 'Legal', heading } = Astro.props;

// Sin estos datos los textos legales están incompletos: el build lo avisa
if (missingLegal.length) console.warn(`[legal] Faltan datos en src/data/legal.ts: ${missingLegal.join(', ')}`);

const updated = legal.updated
	? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(legal.updated))
	: '';
---

<!-- Textos legales: accesibles desde el pie, pero fuera de los buscadores -->
<Layout title={title} description={description} noindex>
	<Navbar />
	<main>
		<article class="legal" aria-labelledby="legal-title">
			<header class="head">
				<p class="eyebrow">{eyebrow}</p>
				<h1 id="legal-title" class="title">{heading}</h1>
				{updated && <p class="updated">Última actualización: {updated}</p>}
			</header>
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
	<Footer />
</Layout>

<style>
	/* Páginas legales: el mismo papel, marco y tipografía que el resto, sin
	   escenas ni animaciones. Lectura cómoda: una columna de texto en el eje
	   de la landing (etiqueta | texto). */

	.legal {
		box-sizing: border-box;
		width: var(--frame);
		margin-inline: auto;
		padding: calc(var(--nav-top) + var(--nav-height) + clamp(3rem, 10svh, 6.5rem)) var(--frame-pad)
			clamp(5rem, 14svh, 9rem);
	}

	.head {
		max-width: 46rem;
	}

	.eyebrow {
		margin-bottom: clamp(1rem, 2.5svh, 1.5rem);
	}

	.title {
		margin: 0;
		font-size: clamp(2.25rem, 1.2rem + 4vw, 4.5rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.updated {
		margin: 1.25rem 0 0;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.prose {
		max-width: 46rem;
		margin-top: clamp(2.5rem, 7svh, 4rem);
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	.prose :global(h2) {
		margin: 2.75rem 0 0.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(dl) {
		margin: 0 0 1rem;
	}

	.prose :global(ul) {
		padding-left: 1.25rem;
		list-style: disc;
	}

	.prose :global(li + li) {
		margin-top: 0.35rem;
	}

	/* Ficha de datos (titular, NIF…): etiqueta y valor en línea */
	.prose :global(dl) {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: 0.4rem 1.5rem;
	}

	.prose :global(dt) {
		color: var(--text-muted);
	}

	.prose :global(dd) {
		margin: 0;
	}

	.prose :global(a) {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(23 23 23 / 0.3);
		text-underline-offset: 0.25em;
	}

	.prose :global(a:hover) {
		text-decoration-color: currentColor;
	}

	.prose :global(.muted) {
		color: var(--text-muted);
	}

	@media (max-width: 30rem) {
		.prose :global(dl) {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.prose :global(dd + dt) {
			margin-top: 0.6rem;
		}
	}
</style>
