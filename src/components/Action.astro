---
import { whatsappHref } from '../data/contact';

// Sin número real todavía: el enlace no se muestra (un botón que no lleva a
// ninguna parte rompe la confianza justo donde se pide) y el build lo avisa
if (!whatsappHref) console.warn('[Action] Falta contact.whatsappNumber en src/data/contact.ts');
---

<section class="action" aria-labelledby="action-title" data-action>
	<div class="stage" data-action-part="stage">
		<h2 id="action-title" class="title" data-action-part="title">
			<span>¿Qué podríamos</span> <span>mejorar en</span> <span>tu negocio?</span>
		</h2>

		<p class="lead" data-action-part="follow">
			<span>Te hago una auditoría gratuita</span> <span>y te enseño hasta&nbsp;3&nbsp;oportunidades concretas.</span>
		</p>

		<div class="actions" data-action-part="follow">
			<!-- La auditoría se pide desde la página de contacto -->
			<a class="primary" href="/contacto">Solicitar auditoría gratuita</a>
			{whatsappHref && (
				<a class="secondary" href={whatsappHref} target="_blank" rel="noopener">
					Hablar por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span>
					<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
						<path d="M3 9 9 3M4 3h5v5" />
					</svg>
				</a>
			)}
		</div>
	</div>
</section>

<style>
	/* Acto 06. Al final, la sección más quieta: una pregunta,
	   una frase y dos caminos. Sin tarjeta ni fondo: la tipografía construye
	   la sección.

	   La pregunta vive en el mismo eje que el titular del Hero, que termina
	   en «a tu negocio.»; esta termina en «tu negocio?». La landing se cierra
	   donde empezó.

	   El único coral es el botón principal: la primera vez que la página pide
	   algo.

	   CTA = invitar. «Solicitar auditoría gratuita» lleva a /contacto, la
	   página donde se escribe; «Hablar por WhatsApp», a la conversación.

	   Por defecto (sin JS o con movimiento reducido), una sección en flujo
	   normal. Con movimiento, el script añade .finale-on a <html> y la CTA y
	   el footer forman la escena final (ver el final de este bloque). */

	.action {
		width: var(--frame);
		margin-inline: auto;
		/* Aire generoso, pero sin recorrido vacío: el espacio de arriba es el
		   silencio tras Más trabajo, y en él la pregunta se enfoca */
		padding: clamp(6rem, 24svh, 14rem) var(--frame-pad) clamp(6rem, 22svh, 12rem);
	}

	/* Móvil: «¿Qué podríamos» (la línea más ancha, 7.8em) llena la columna
	   sin partirse */
	.title {
		margin: 0;
		font-size: clamp(1.75rem, (100vw - 2 * var(--gutter) - 2 * var(--frame-pad)) / 8, 4rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.title span {
		display: block;
	}

	/* Escritorio: por encima del titular del Hero (hasta 7.5rem), ~60% del
	   ancho en 1440 px, y nunca más alto que lo que cabe con aire */
	@media (min-width: 48rem) {
		.title {
			font-size: clamp(3.5rem, min(8.6vw, 13svh), 7.5rem);
		}
	}

	.lead {
		margin: clamp(2rem, 6svh, 3.5rem) 0 0;
		font-size: clamp(1.125rem, 0.9rem + 0.7vw, 1.5rem);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	/* Cortes naturales: qué ofrezco / qué te llevas. Si en móvil un bloque
	   no cabe, se reparte en renglones equilibrados dentro de sí mismo. */
	.lead span {
		display: block;
		text-wrap: balance;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2.25rem;
		margin-top: clamp(2rem, 5svh, 3rem);
	}

	/* Principal: píldora coral, como la navegación pero llena. Texto oscuro
	   sobre coral (contraste 7.5:1). Al pasar el ratón, un halo melocotón. */
	.primary {
		display: inline-flex;
		align-items: center;
		min-height: 3.5rem;
		padding: 0 1.75rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--text);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		text-decoration: none;
		transition: box-shadow 0.4s var(--ease-out);
	}

	.primary:hover {
		box-shadow: 0 0 0 0.4rem var(--accent-soft);
	}

	/* Secundaria: texto subrayado con flecha, como «Ver sitio en vivo» */
	.secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		min-height: 2.75rem;
		font-size: 1rem;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(23 23 23 / 0.25);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: text-decoration-color 0.3s var(--ease-out);
	}

	.secondary:hover {
		text-decoration-color: currentColor;
	}

	.secondary svg {
		width: 0.7em;
		height: 0.7em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.3s var(--ease-out);
	}

	@media (prefers-reduced-motion: no-preference) {
		.secondary:hover svg {
			translate: 0.1em -0.1em;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Móvil: el botón ocupa todo el ancho (área táctil cómoda) y WhatsApp
	   queda debajo */
	@media (max-width: 30rem) {
		.actions {
			flex-direction: column;
			align-items: stretch;
		}

		.primary {
			justify-content: center;
		}

		.secondary {
			justify-content: center;
		}
	}

	/* ---------- Escena final: CTA → footer ----------
	   La sección aporta el recorrido y su escenario (sticky) se queda fijo:
	     --action-hold   la pausa: la CTA completa, quieta, para decidir
	     --finale-leave  la transición: la CTA se disuelve y, detrás, aparece
	                     el footer, que ocupa este mismo tramo (Footer.astro)
	   La timeline está en scripts/action.ts. */

	.action {
		--action-hold: 60svh;
	}

	@media (max-width: 48rem) {
		.action {
			--action-hold: 45svh;
		}
	}

	/* El silencio tras Más trabajo es margen, fuera del recorrido */
	:global(.finale-on) .action {
		width: auto;
		height: calc(100svh + var(--action-hold) + var(--finale-leave));
		margin-top: clamp(6rem, 24svh, 14rem);
		padding: 0;
	}

	:global(.finale-on) .stage {
		position: sticky;
		top: 0;
		box-sizing: border-box;
		height: 100svh;
		width: var(--frame);
		margin-inline: auto;
		padding: calc(var(--nav-top) + var(--nav-height)) var(--frame-pad) 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	:global(.finale-on) :is(.title, .lead, .actions) {
		will-change: opacity, filter, transform;
	}

	/* Se enfoca y se aleja hacia su eje (el texto está alineado a la izquierda) */
	:global(.finale-on) .title {
		transform-origin: 0 50%;
	}

	/* Mientras se disuelve, sus enlaces dejan de recibir clics */
	:global(.finale-on) .action:global(.is-leaving) a {
		pointer-events: none;
	}
</style>

<script>
	import { initAction } from '../scripts/action';
	import { cinematic } from '../scripts/motion';

	const section = document.querySelector<HTMLElement>('[data-action]');

	if (section && cinematic()) initAction(section);
</script>
