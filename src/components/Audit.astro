---
import { Picture } from 'astro:assets';
import { audit, person } from '../data/audit';

// El método. Los cuatro primeros pasos son la auditoría (gratis); el quinto
// es el trabajo, y solo ocurre si algo merece la pena.
const steps = [
	{
		name: 'Escuchar',
		text: 'Me cuentas qué te preocupa y dónde se te va el tiempo.',
	},
	{
		name: 'Observar',
		text: 'Miro tu web, tu ficha de Google, tus redes y cómo funciona hoy el negocio.',
	},
	{
		name: 'Contrastar',
		text: 'Lo que veo, te lo pregunto. Una observación no es un problema hasta que la contrasto contigo.',
	},
	{
		name: 'Priorizar',
		text: 'Te digo qué merece la pena y qué no.',
	},
];

const build = {
	name: 'Construir',
	text: 'Solo después, y solo si tiene sentido. Puede ser una web, una automatización, IA, una integración… o nada.',
};

// Datos prácticos: solo los que ya están decididos (ver src/data/audit.ts)
const facts = [audit.delivery, audit.turnaround && `Plazo: ${audit.turnaround}.`].filter(Boolean);
---

<section class="audit" aria-labelledby="audit-title">
	<header class="intro" data-reveal>
		<p class="eyebrow" data-reveal-item>La auditoría gratuita</p>
		<h2 id="audit-title" class="title">
			<span data-reveal-item="scale">Primero miro.</span>{' '}
			<span data-reveal-item="scale">Después decido.</span>{' '}
			<span data-reveal-item="scale">Luego construyo.</span>
		</h2>
	</header>

	<ol class="steps">
		{
			steps.map(({ name, text }, i) => (
				<li class="row" data-reveal>
					<h3 class="step-label" data-reveal-item>
						<span class="numeral" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{' '}
						<span class="step-name">{name}</span>
					</h3>
					<div class="body" data-reveal-item>
						<p class="text">{text}</p>
					</div>
					<span class="row-rule" data-reveal-line aria-hidden="true" />
				</li>
			))
		}

		<!-- La frontera: hasta aquí, gratis. Una línea oscura en lugar de la fina. -->
		<li class="row after" data-reveal>
			<p class="boundary" data-reveal-item>Hasta aquí, la auditoría. Gratis y sin compromiso.</p>
			<h3 class="step-label" data-reveal-item>
				<span class="numeral" aria-hidden="true">05</span>{' '}
				<span class="step-name">{build.name}</span>
			</h3>
			<div class="body" data-reveal-item>
				<p class="text">{build.text}</p>
			</div>
			<span class="row-rule" data-reveal-line aria-hidden="true"></span>
		</li>
	</ol>

	<div class="row outcome" data-reveal>
		<h3 class="eyebrow" data-reveal-item>Lo que te llevas</h3>
		<div class="body" data-reveal-item>
			<p class="promise">Hasta 3&nbsp;oportunidades concretas.</p>
			<p class="text">
				Solo las que merezcan la pena: qué pasa hoy, por qué importa, qué tipo de solución tendría y por cuál
				empezaría yo.
			</p>
			<p class="text">Si la IA tiene sentido en tu negocio, te digo dónde. Si no lo tiene, también.</p>
			<p class="small">No es un informe de 40 páginas. Es una conversación y una lista corta.</p>
			{facts.length > 0 && <p class="small">{facts.join(' ')}</p>}
		</div>
		<span class="row-rule" data-reveal-line aria-hidden="true"></span>
	</div>

	<div class="row person" data-reveal>
		<h3 class="eyebrow" data-reveal-item>Quién mira</h3>
		<div class="body person-body" data-reveal-item>
			{
				person.photo && (
					<Picture
						class="photo"
						pictureAttributes={{ class: 'photo-frame' }}
						src={person.photo}
						alt={person.name}
						widths={[240, 320]}
						sizes="(max-width: 48rem) 7rem, 9rem"
						formats={['avif', 'webp']}
					/>
				)
			}
			<div>
				<p class="name">{person.name}</p>
				<p class="text">
					Trabajo solo, desde Málaga. Hablas conmigo desde la primera pregunta hasta lo último que
					construyamos.
				</p>
				<p class="text muted">Construyo webs, sistemas de reservas, automatizaciones y herramientas con IA.</p>
			</div>
		</div>
		<span class="row-rule" data-reveal-line aria-hidden="true"></span>
	</div>

	<!-- Para pedirla aquí mismo, sin esperar al final de la página. Un enlace
	     en la columna del texto, como «Ver la web»: el botón coral se reserva
	     para la CTA final. -->
	<div class="row next" data-reveal>
		<p class="next-body" data-reveal-item>
			<a class="next-link" href="/contacto">
				Solicitar auditoría gratuita
				<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5" /></svg>
			</a>
		</p>
		<span class="row-rule" data-reveal-line aria-hidden="true"></span>
	</div>
</section>

<style>
	/* Acto 04. La auditoría: el caso se convierte en oferta. «Esto que acabas
	   de ver es lo que hago contigo.»

	   Misma retícula que el caso (filas de índice, global.css). El método en
	   cinco pasos: los cuatro primeros son la auditoría; una línea oscura
	   marca la frontera y el quinto, construir, queda en gris porque solo
	   ocurre si algo merece la pena. Después, lo que te llevas y quién mira. */

	.audit {
		width: var(--frame);
		margin-inline: auto;
		padding: clamp(5rem, 18svh, 12rem) var(--frame-pad) clamp(4rem, 12svh, 8rem);
	}

	/* Tres tiempos, tres renglones que llegan uno detrás de otro. Escalonados
	   hacia la derecha en escritorio: el método avanza. En móvil manda el
	   ancho: «Luego construyo.» es la línea más ancha (~7.9em). */
	.title {
		margin: clamp(1.25rem, 3svh, 2rem) 0 0;
		font-size: clamp(1.75rem, (100vw - 2 * var(--gutter) - 2 * var(--frame-pad)) / 8.3, 5rem);
		font-weight: 400;
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.title span {
		display: block;
		transform-origin: 0 50%;
	}

	@media (min-width: 48.0625rem) and (orientation: landscape), (min-width: 75.0625rem) {
		.title {
			font-size: clamp(3rem, min(7vw, 11svh), 6.5rem);
		}

		.title span:nth-child(2) {
			padding-left: 1.2em;
		}

		.title span:nth-child(3) {
			padding-left: 2.4em;
		}
	}

	.steps {
		margin: clamp(3.5rem, 10svh, 6rem) 0 0;
		padding: 0;
		list-style: none;
	}

	/* Cada paso: un número grande y ligero (un objeto, no un dato) y su
	   nombre, que hace de titular. La explicación va como texto secundario. */
	.step-label {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		font-weight: 400;
	}

	.step-name {
		font-size: clamp(1.375rem, 1rem + 1.1vw, 2rem);
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--text);
	}

	.numeral {
		font-size: clamp(2.75rem, 1.5rem + 3vw, 4.75rem);
		font-weight: 300;
		line-height: 0.85;
		letter-spacing: -0.05em;
		color: rgb(23 23 23 / 0.3);
		font-variant-numeric: tabular-nums;
	}

	.body {
		max-width: 44rem;
	}

	/* Texto secundario: explica lo que dicen los titulares */
	.text {
		margin: 0;
		font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
		line-height: 1.5;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}

	.steps .text {
		color: var(--text-muted);
	}

	.text + .text {
		margin-top: 0.8em;
	}

	.muted {
		color: var(--text-muted);
	}

	/* ---------- La frontera ---------- */

	.after {
		margin-top: clamp(1rem, 3svh, 2rem);
	}

	.after .row-rule {
		height: 2px;
		background: var(--text);
	}

	/* Sobre la línea, a la derecha: lo que queda a un lado y al otro */
	.boundary {
		position: absolute;
		right: 0;
		bottom: 100%;
		margin: 0 0 0.6rem;
		font-size: 0.875rem;
		line-height: 1.3;
	}

	.after .step-name,
	.after .text {
		color: var(--text-muted);
	}

	/* Más claro que los de la auditoría (es lo que viene después), pero
	   legible también en pantallas con poco contraste */
	.after .numeral {
		color: rgb(23 23 23 / 0.2);
	}

	/* ---------- Lo que te llevas ---------- */

	.outcome {
		margin-top: clamp(4rem, 12svh, 8rem);
	}

	/* La promesa comercial de la sección: a escala de titular, con todo el
	   ancho de la columna (el texto que la explica sigue a su medida) */
	.outcome .body {
		max-width: none;
	}

	.outcome .body > :not(.promise) {
		max-width: 44rem;
	}

	.promise {
		margin: 0 0 clamp(1.5rem, 4svh, 2.5rem);
		font-size: clamp(2.5rem, 1rem + 5vw, 5.75rem);
		line-height: 1;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.small {
		margin: 1.25rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* ---------- Quién mira ---------- */

	.person-body {
		display: flex;
		align-items: flex-start;
		gap: clamp(1.25rem, 3vw, 2rem);
	}

	/* El marco (<picture>) no encoge en la fila; la imagen lo llena */
	.photo-frame {
		flex: none;
		width: clamp(5.5rem, 10vw, 9rem);
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 0.75rem;
	}

	.name {
		margin: 0 0 0.75rem;
		font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem);
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	/* ---------- Pedir la auditoría ---------- */

	.next-body {
		grid-column: 2;
		margin: 0;
	}

	.next-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		min-height: 2.75rem;
		font-size: clamp(1.125rem, 1rem + 0.45vw, 1.375rem);
		letter-spacing: -0.015em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(23 23 23 / 0.25);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: text-decoration-color 0.3s var(--ease-out);
	}

	.next-link:hover {
		text-decoration-color: currentColor;
	}

	.next-link svg {
		width: 0.75em;
		height: 0.75em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.3s var(--ease-out);
	}

	@media (prefers-reduced-motion: no-preference) {
		.next-link:hover svg {
			translate: 0.15em 0;
		}
	}

	@media (max-width: 48rem), (orientation: portrait) and (max-width: 75rem) {
		.next-body {
			grid-column: 1;
		}

		/* El número y el nombre, en línea */
		.step-label {
			flex-direction: row;
			align-items: baseline;
			gap: 0.75rem;
		}

		/* La frontera, como en escritorio, sobre la línea oscura (cierra los
		   cuatro pasos de arriba), pero alineada a la izquierda. Más aire
		   encima para que quepa en dos renglones. */
		.boundary {
			left: 0;
			right: auto;
		}

		.after {
			margin-top: 3rem;
		}
	}
</style>
