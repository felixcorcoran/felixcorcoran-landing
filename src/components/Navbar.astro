---
import { isCurrent, primary } from '../data/navigation';
import { langOf, routes } from '../i18n';

const { pathname } = Astro.url;
const lang = langOf(Astro.currentLocale);
const links = primary(lang);

const text = {
	es: { nav: 'Principal', home: 'felixcorcoran — inicio', dark: 'Modo oscuro' },
	en: { nav: 'Main', home: 'felixcorcoran — home', dark: 'Dark mode' },
}[lang];
---

<header class="nav" data-nav>
	<nav class="pill" aria-label={text.nav}>
		<a class="logo" href={routes.home[lang]} aria-label={text.home}>
			<span class="logo-first">felix</span><span class="logo-last">corcoran</span>
		</a>
		<ul class="links">
			<!-- Claro u oscuro: la web es clara por defecto; este botón lo cambia y
			     se recuerda en este navegador -->
			<li class="theme-item">
				<button class="theme" type="button" aria-pressed="false" aria-label={text.dark} title={text.dark} data-theme-toggle>
					<svg class="moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
					</svg>
					<svg class="sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
					</svg>
				</button>
			</li>
			{links.map(({ href, label, highlight }) => (
				<li>
					<a class:list={{ highlight }} href={href} aria-current={isCurrent(href, pathname) ? 'page' : undefined}>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>
	.nav {
		position: fixed;
		inset: var(--nav-top) 0 auto;
		z-index: 100;
		pointer-events: none;
	}

	.pill {
		pointer-events: auto;
		width: var(--frame);
		margin-inline: auto;
		height: var(--nav-height);
		padding-inline: var(--frame-pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		border-radius: 999px;
		background: rgb(var(--paper) / 0.65);
		border: 1px solid rgb(var(--ink) / 0.06);
		/* Canto de luz arriba + sombra ambiental casi imperceptible */
		box-shadow:
			inset 0 1px 0 rgb(var(--surface-rgb) / 0.7),
			0 10px 30px -16px rgb(var(--ink) / 0.1);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.logo {
		font-size: 1.0625rem;
		letter-spacing: -0.025em;
		line-height: 1;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-first {
		font-weight: 300;
		color: rgb(var(--ink) / 0.82);
	}

	.logo-last {
		font-weight: 600;
	}

	.links {
		display: flex;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* El botón del tema: un icono pequeño y gris, como un enlace más.
	   Luna en claro (pasa a oscuro); sol en oscuro (vuelve a claro). */
	.theme {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin: 0 -0.5rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.25s var(--ease-out);
	}

	.theme:hover {
		color: var(--text);
	}

	.theme svg {
		grid-area: 1 / 1;
		width: 1.0625rem;
		height: 1.0625rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.theme .sun,
	:global([data-theme="dark"]) .theme .moon {
		display: none;
	}

	:global([data-theme="dark"]) .theme .sun {
		display: block;
	}

	.links a {
		font-size: 0.875rem;
		letter-spacing: -0.005em;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.25s var(--ease-out);
	}

	.links a:hover,
	.links a[aria-current="page"] {
		color: var(--text);
	}

	/* Contacto: una píldora finísima con el punto coral. Se distingue de un
	   enlace más sin convertirse en un botón. */
	.links {
		align-items: center;
	}

	/* Encajada en la barra: el mismo margen (0.5rem) arriba, abajo y a la
	   derecha, como una píldora dentro de otra */
	.links a.highlight {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		height: calc(var(--nav-height) - 1rem);
		margin-right: calc(0.5rem - var(--frame-pad));
		padding: 0 0.9rem;
		border-radius: 999px;
		box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.18);
		color: var(--text);
		transition:
			box-shadow 0.25s var(--ease-out),
			background-color 0.25s var(--ease-out);
	}

	.links a.highlight::before {
		content: "";
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.links a.highlight:hover {
		background-color: rgb(var(--surface-rgb) / 0.7);
		box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.3);
	}

	@media (max-width: 40rem) {
		.logo {
			font-size: 1rem;
		}

		/* En móvil, con el botón del tema, los enlaces más juntos para que la
		   píldora de Contacto siga encajada en la barra */
		.links {
			gap: 0.75rem;
		}

		.theme {
			width: 1.75rem;
			margin: 0 -0.375rem 0 -0.625rem;
		}
	}

	/* Móviles estrechos (≤360 px): los dos enlaces caben junto al logo con
	   algo menos de aire interior */
	@media (max-width: 22.5rem) {
		.pill,
		.links {
			gap: 0.75rem;
		}

		.pill {
			padding-inline: 0.875rem;
		}

		.logo {
			font-size: 0.9375rem;
		}

		/* El botón del tema, más ceñido: con él, los enlaces caben a 320 px */
		.links {
			gap: 0.625rem;
		}

		.theme {
			width: 1.75rem;
			margin: 0 -0.625rem 0 -0.375rem;
		}

		/* Sin sitio para la píldora: queda el punto coral */
		.links a.highlight {
			height: auto;
			margin-right: 0;
			padding: 0;
			box-shadow: none;
		}
	}

	/* Móviles de 320 px (muy pocos): no cabe junto a los enlaces y se queda
	   la web clara, que es la de siempre */
	@media (max-width: 21.25rem) {
		.theme-item {
			display: none;
		}
	}

	/* Escena final (footer): la navegación se retira. La activa el script del
	   footer con .is-away. Sigue siendo enfocable: si se llega a ella con el
	   teclado, vuelve. */
	.nav:global(.is-away) .pill {
		opacity: 0;
		translate: 0 -0.5rem;
		pointer-events: none;
	}

	.nav:global(.is-away):focus-within .pill {
		opacity: 1;
		translate: none;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* backwards (no both): al terminar, la animación deja de aplicarse y
		   la retirada puede hacer su transición sin saltos */
		.pill {
			animation: nav-in 1s var(--ease-out) backwards;
			transition:
				opacity 0.5s var(--ease-out),
				translate 0.5s var(--ease-out);
		}
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}
</style>

<script>
	const root = document.documentElement;
	const meta = document.querySelector('[data-theme-color]');

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
		const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
		sync();
		button.addEventListener('click', () => {
			const dark = root.dataset.theme !== 'dark';
			if (dark) root.dataset.theme = 'dark';
			else delete root.dataset.theme;
			meta?.setAttribute('content', dark ? '#131211' : '#FAF9F6');
			// Preferencia elegida por el visitante, solo en su navegador. Si no
			// se puede guardar, el cambio vale para esta visita.
			try {
				if (dark) localStorage.setItem('tema', 'oscuro');
				else localStorage.removeItem('tema');
			} catch {}
			sync();
		});
	}
</script>
