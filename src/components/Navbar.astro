---
import { isCurrent, primary as links } from '../data/navigation';

const { pathname } = Astro.url;
---

<header class="nav" data-nav>
	<nav class="pill" aria-label="Principal">
		<a class="logo" href="/" aria-label="felixcorcoran — inicio">
			<span class="logo-first">felix</span><span class="logo-last">corcoran</span>
		</a>
		<ul class="links">
			{links.map(({ href, label, highlight }) => (
				<li>
					<a class:list={{ highlight }} href={href} aria-current={isCurrent(href, pathname) ? 'page' : undefined}>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>
	.nav {
		position: fixed;
		inset: var(--nav-top) 0 auto;
		z-index: 100;
		pointer-events: none;
	}

	.pill {
		pointer-events: auto;
		width: var(--frame);
		margin-inline: auto;
		height: var(--nav-height);
		padding-inline: var(--frame-pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		border-radius: 999px;
		background: rgb(250 249 246 / 0.65);
		border: 1px solid rgb(0 0 0 / 0.04);
		/* Canto de luz arriba + sombra ambiental casi imperceptible */
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.7),
			0 10px 30px -16px rgb(23 23 23 / 0.1);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.logo {
		font-size: 1.0625rem;
		letter-spacing: -0.025em;
		line-height: 1;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-first {
		font-weight: 300;
		color: rgb(23 23 23 / 0.82);
	}

	.logo-last {
		font-weight: 600;
	}

	.links {
		display: flex;
		gap: clamp(1.5rem, 2.6vw, 2.5rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.links a {
		font-size: 0.875rem;
		letter-spacing: -0.005em;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.25s var(--ease-out);
	}

	.links a:hover,
	.links a[aria-current="page"] {
		color: var(--text);
	}

	/* Contacto: una píldora finísima con el punto coral. Se distingue de un
	   enlace más sin convertirse en un botón. */
	.links {
		align-items: center;
	}

	/* Encajada en la barra: el mismo margen (0.5rem) arriba, abajo y a la
	   derecha, como una píldora dentro de otra */
	.links a.highlight {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		height: calc(var(--nav-height) - 1rem);
		margin-right: calc(0.5rem - var(--frame-pad));
		padding: 0 0.9rem;
		border-radius: 999px;
		box-shadow: inset 0 0 0 1px rgb(23 23 23 / 0.12);
		color: var(--text);
		transition:
			box-shadow 0.25s var(--ease-out),
			background-color 0.25s var(--ease-out);
	}

	.links a.highlight::before {
		content: "";
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--accent);
	}

	.links a.highlight:hover {
		background-color: rgb(255 255 255 / 0.7);
		box-shadow: inset 0 0 0 1px rgb(23 23 23 / 0.22);
	}

	@media (max-width: 40rem) {
		.logo {
			font-size: 1rem;
		}
	}

	/* Móviles estrechos (≤360 px): los dos enlaces caben junto al logo con
	   algo menos de aire interior */
	@media (max-width: 22.5rem) {
		.pill,
		.links {
			gap: 0.75rem;
		}

		.pill {
			padding-inline: 0.875rem;
		}

		.logo {
			font-size: 0.9375rem;
		}

		/* Sin sitio para la píldora: queda el punto coral */
		.links a.highlight {
			height: auto;
			margin-right: 0;
			padding: 0;
			box-shadow: none;
		}
	}

	/* Escena final (footer): la navegación se retira. La activa el script del
	   footer con .is-away. Sigue siendo enfocable: si se llega a ella con el
	   teclado, vuelve. */
	.nav:global(.is-away) .pill {
		opacity: 0;
		translate: 0 -0.5rem;
		pointer-events: none;
	}

	.nav:global(.is-away):focus-within .pill {
		opacity: 1;
		translate: none;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* backwards (no both): al terminar, la animación deja de aplicarse y
		   la retirada puede hacer su transición sin saltos */
		.pill {
			animation: nav-in 1s var(--ease-out) backwards;
			transition:
				opacity 0.5s var(--ease-out),
				translate 0.5s var(--ease-out);
		}
	}

	@keyframes nav-in {
		from {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}
</style>
