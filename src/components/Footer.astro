---
import { contact } from '../data/contact';
import { footer, isCurrent } from '../data/navigation';
import { alternatesOf, langOf, routes } from '../i18n';

const { pathname } = Astro.url;
const lang = langOf(Astro.currentLocale);
const links = footer(lang);

// El otro idioma, discreto, junto a las legales: la misma página si existe
// en él; si no (legales, 404), su inicio. Quien llega desde Google ya entra
// en el suyo (hreflang)
const other = lang === 'es' ? 'en' : 'es';
const alternates = alternatesOf(pathname);
const switchHref = alternates ? alternates[other] : routes.home[other];
const switchLabel = { es: 'Español', en: 'English' }[other];

// Las legales existen solo en español (los enlaces llevan hreflang="es")
const t = {
	es: { sections: 'Secciones', cta: 'Solicitar auditoría gratuita', legal: 'Aviso legal', privacy: 'Privacidad' },
	en: { sections: 'Sections', cta: 'Request a free audit', legal: 'Legal notice', privacy: 'Privacy' },
}[lang];

// La CTA se queda en la firma: quien llega al final de la página (o salta a
// él) sigue teniendo a mano la auditoría. En /contacto ya está en ella.
const showCta = !isCurrent(routes.contact[lang], pathname);
---

<footer class="footer" data-footer>
	<div class="inner">
		<nav class="sections" aria-label={t.sections} data-footer-part="nav">
			<ul>
				{links.map(({ href, label }) => (
					<li><a href={href} aria-current={isCurrent(href, pathname) ? 'page' : undefined}>{label}</a></li>
				))}
			</ul>
		</nav>

		<p class="brand" data-footer-part="brand">
			<span class="brand-first">felix</span><span class="brand-last">corcoran</span>
		</p>

		<div class="fine" data-footer-part="fine">
			{showCta && (
				<a class="cta" href={routes.contact[lang]}>
					{t.cta}
					<svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5" /></svg>
				</a>
			)}
			<a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
			<span class="legal">
				<a href="/aviso-legal" hreflang="es" aria-current={isCurrent('/aviso-legal', pathname) ? 'page' : undefined}>{t.legal}</a>
				<a href="/privacidad" hreflang="es" aria-current={isCurrent('/privacidad', pathname) ? 'page' : undefined}>{t.privacy}</a>
				<a href={switchHref} hreflang={other} lang={other}>{switchLabel}</a>
			</span>
		</div>
	</div>
</footer>

<style>
	/* Escena final: la firma. Una pantalla entera con muchísimo aire y tres
	   niveles:
	     01  felixcorcoran, gigante: ocupa de eje a eje, apoyada abajo como
	         la base de la página
	     02  Inicio · Trabajo · Contacto, una línea tipográfica en la banda
	         donde vivía la píldora de navegación, alineada a su borde
	     03  la letra pequeña bajo la firma: pedir la auditoría y el correo

	   En la landing, con movimiento (html.finale-on), el footer está detrás
	   del final de la CTA: se revela mientras ella se disuelve
	   (scripts/action.ts). En /contacto (y sin movimiento) va en flujo
	   normal y la píldora se retira al llegar a él (script de abajo). */

	/* Fuera de <main>: lleva su propio grano para que el papel sea continuo */
	/* overflow-x: clip (no hidden: no crea contenedor de scroll, el sticky
	   sigue funcionando). En móviles muy estrechos, los enlaces llegan con el
	   desplazados (scripts/action.ts) y no deben ensanchar la página. */
	.footer {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
	}

	.footer::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: var(--grain);
		background-image: var(--grain-image);
	}

	/* svh: la altura no cambia al mostrarse u ocultarse la barra del
	   navegador móvil (sin saltos de layout al hacer scroll).
	   Sin el tope de 84rem del marco: sin navegación flotante encima, la
	   firma se mide contra los márgenes de la pantalla. */
	.inner {
		box-sizing: border-box;
		min-height: 100svh;
		width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
		/* Arriba, la banda de la navegación (mismo alto y posición que la
		   píldora); abajo, el margen de la letra pequeña */
		padding: var(--nav-top) var(--frame-pad) clamp(1.5rem, 4svh, 2.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-rows: auto 1fr auto auto;
		grid-template-areas:
			". sections"
			". ."
			"brand brand"
			"fine fine";
		container-type: inline-size;
	}

	/* ---------- 01 · La firma ----------
	   Mismo lenguaje que la marca de la navegación (felix 300, corcoran 600),
	   con el tracking algo más cerrado que pide el tamaño. Mide exactamente
	   el ancho de la columna: «felixcorcoran» ocupa 6.16em. */
	.brand {
		--brand-em: 6.16;

		grid-area: brand;
		margin: 0 0 clamp(1.25rem, 4svh, 2.5rem);
		font-size: calc((100vw - 2 * var(--gutter) - 2 * var(--frame-pad)) / var(--brand-em) - 0.1rem);
		font-size: calc(100cqw / var(--brand-em));
		line-height: 0.8;
		letter-spacing: -0.045em;
		white-space: nowrap;
	}

	.brand-first {
		font-weight: 300;
		color: rgb(var(--ink) / 0.82);
	}

	.brand-last {
		font-weight: 600;
	}

	/* ---------- 02 · Secciones ----------
	   Tres palabras en línea, sin caja ni lista a la vista: la navegación de
	   la píldora, ya sin píldora y a mayor escala. Al pasar el ratón se
	   dibuja bajo la palabra el subrayado coral de «adecuada». */
	.sections {
		grid-area: sections;
		justify-self: end;
		display: flex;
		align-items: center;
		min-height: var(--nav-height);
	}

	.sections ul {
		display: flex;
		gap: clamp(1.5rem, 3vw, 3rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sections a {
		position: relative;
		display: inline-block;
		padding-block: 0.5rem;
		font-size: clamp(1.0625rem, 0.9rem + 0.55vw, 1.5rem);
		line-height: 1;
		letter-spacing: -0.015em;
		color: var(--text);
		text-decoration: none;
	}

	.sections a::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.15rem;
		height: max(1px, 0.07em);
		border-radius: 1em;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.sections a:hover::after {
		transform: scaleX(1);
	}

	@media (prefers-reduced-motion: no-preference) {
		.sections a::after {
			transition: transform 0.45s var(--ease-out);
		}
	}

	/* ---------- 03 · Letra pequeña ----------
	   La CTA, un poco más grande y en negro; el correo, a su lado */
	.fine {
		grid-area: fine;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem clamp(1.5rem, 3vw, 2.5rem);
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		padding-block: 0.4rem;
		font-size: 1rem;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: max(1px, 0.07em);
		text-underline-offset: 0.3em;
	}

	.cta svg {
		width: 0.75em;
		height: 0.75em;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.3s var(--ease-out);
	}

	@media (prefers-reduced-motion: no-preference) {
		.cta:hover svg {
			translate: 0.15em 0;
		}
	}

	.mail {
		font-size: 0.875rem;
		padding-block: 0.4rem;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: rgb(var(--ink) / 0.25);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: text-decoration-color 0.3s var(--ease-out);
	}

	/* Lo legal, a la derecha y en gris: está, pero no compite con la CTA */
	.legal {
		display: flex;
		gap: 1.25rem;
		margin-left: auto;
	}

	.legal a {
		padding-block: 0.4rem;
		white-space: nowrap;
		font-size: 0.8125rem;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.3s var(--ease-out);
	}

	.legal a:hover,
	.legal a[aria-current="page"] {
		color: var(--text);
	}

	.mail:hover {
		text-decoration-color: currentColor;
	}

	/* Móvil: la línea de secciones sigue arriba a la derecha; la firma, del
	   ancho del marco (algo más ancha que la columna de texto); el correo debajo. Enlaces de 44 px de alto. */
	@media (max-width: 40rem) {
		.inner {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: auto 1fr auto auto;
			grid-template-areas:
				"sections"
				"."
				"brand"
				"fine";
			padding-inline: 0;
		}

		.sections,
		.fine {
			margin-inline: var(--frame-pad);
		}

		.fine {
			flex-direction: column;
			align-items: flex-start;
		}

		.sections ul {
			gap: 1.25rem;
		}

		.sections a {
			padding-block: 0.85rem;
		}

		.cta,
		.mail {
			padding-block: 0.7rem;
		}

		.legal {
			margin-left: 0;
		}

		.legal a {
			padding-block: 0.7rem;
		}

		.brand {
			margin-bottom: 1.5rem;
		}
	}

	/* ---------- Escena final ----------
	   Se superpone (margen negativo) a la última pantalla de la CTA y a su
	   transición, --finale-leave, y su contenido se queda fijo (sticky)
	   durante ella: al disolverse la CTA, el footer ya estaba ahí. Encima de
	   <main> en el apilado, pero sin recibir clics hasta que se abre.

	   Fuera de la landing (/contacto, legales: html.footer-reveal), lo mismo
	   con una transición más corta. Ahí no hay escenario fijo: <main> se
	   alarga --finale-leave por abajo y el contenido, al terminar, sube ese
	   tramo mientras se disuelve (scripts/footer-reveal.ts). */
	:global(html.finale-on) {
		--finale-leave: 85svh;
	}

	:global(html.footer-reveal) {
		--finale-leave: 55svh;
	}

	@media (max-width: 48rem), (orientation: portrait) and (max-width: 75rem) {
		:global(html.finale-on) {
			--finale-leave: 70svh;
		}

		:global(html.footer-reveal) {
			--finale-leave: 45svh;
		}
	}

	/* Al menos una pantalla de contenido (border-box: la altura mínima
	   incluye el tramo): si no, el footer taparía el principio de la página.
	   Debajo, el tramo de la transición. */
	:global(html.footer-reveal main) {
		min-height: calc(100svh + var(--finale-leave));
		padding-bottom: var(--finale-leave);
	}

	:global(:is(.finale-on, .footer-reveal)) .footer {
		height: calc(100svh + var(--finale-leave));
		margin-top: calc(-1 * (100svh + var(--finale-leave)));
		pointer-events: none;
	}

	:global(:is(.finale-on, .footer-reveal)) .footer:global(.is-open) {
		pointer-events: auto;
	}

	/* Toda su altura queda dentro de <main>, que ya pone el grano */
	:global(:is(.finale-on, .footer-reveal)) .footer::before {
		display: none;
	}

	:global(:is(.finale-on, .footer-reveal)) .inner {
		position: sticky;
		top: 0;
	}

	:global(:is(.finale-on, .footer-reveal)) :is(.brand, .fine, .sections a) {
		will-change: opacity, filter, transform;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { cinematic } from '../scripts/motion';

	gsap.registerPlugin(ScrollTrigger);

	import { initFooterReveal } from '../scripts/footer-reveal';

	// En la landing, con movimiento, la transición al footer es la escena
	// final (scripts/action.ts). En el resto de páginas (/contacto, legales)
	// hay una versión en flujo normal (scripts/footer-reveal.ts). Sin
	// movimiento, la píldora se retira al llegar al footer: su banda es la de
	// los enlaces del footer.
	const footer = document.querySelector<HTMLElement>('[data-footer]');
	const nav = document.querySelector<HTMLElement>('[data-nav]');
	const landing = document.querySelector('[data-action]');

	if (footer && !landing && cinematic()) {
		initFooterReveal(footer, nav);
	} else if (footer && nav && !(landing && cinematic())) {
		// Solo entrar / volver a subir: en el último píxel de scroll
		// ScrollTrigger da el tramo por terminado y la píldora volvería
		const away = (value: boolean) => () => nav.classList.toggle('is-away', value);
		ScrollTrigger.create({
			trigger: footer,
			start: 'top 55%',
			onEnter: away(true),
			onEnterBack: away(true),
			onLeaveBack: away(false),
		});
	}
</script>
